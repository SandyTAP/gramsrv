# Copy to .env, replace every CHANGEME value, and restrict it to the deployment
# owner (0600 on Unix). The PowerShell generator does this automatically.

COMPOSE_PROJECT_NAME=telesrv
TELESRV_IMAGE_PREFIX=ghcr.io/iamxvbaba/gramsrv
TELESRV_IMAGE_TAG=v2
TELESRV_EDGE_BUILD_TARGET=edge-test
TELESRV_LOG_LEVEL=info

# Build provenance (CI/release builds should set immutable values).
TELESRV_BUILD_COMMIT=unknown
TELESRV_BUILD_BRANCH=v2
TELESRV_BUILD_TREE_STATE=unknown
TELESRV_BUILD_DATE=unknown

# PostgreSQL stays on the private Docker network. URL-encode reserved password
# characters in TELESRV_POSTGRES_DSN.
POSTGRES_DB=telesrv_v2
POSTGRES_USER=telesrv
POSTGRES_PASSWORD=CHANGEME
TELESRV_POSTGRES_DSN=postgres://telesrv:CHANGEME@postgres:5432/telesrv_v2?sslmode=disable

# Redis stays on the private Docker network and requires authentication.
TELESRV_REDIS_PASSWORD=CHANGEME

# Use independent random values (for example: openssl rand -hex 32).
TELESRV_CORE_EXEC_TOKEN=CHANGEME
TELESRV_FILE_TOKEN=CHANGEME
TELESRV_EGRESS_ACK_TOKEN=CHANGEME
TELESRV_GROUPCALL_CONTROL_TOKEN=CHANGEME
TELESRV_SFU_CONTROL_TOKEN=CHANGEME

# Keep the repository's familiar local development code. For an Internet-facing
# deployment, configure a real delivery provider instead of a shared code. The
# generator enables development delivery for loopback, or when
# -AllowInsecureDevelopmentAuth is explicitly requested.
TELESRV_DEV_AUTH_CODE=12345
TELESRV_PHONE_CODE_DELIVERY_PROVIDER=development
TELESRV_ALLOW_INSECURE_DEVELOPMENT_AUTH=false
TELESRV_OTP_WEBHOOK_URL=
TELESRV_OTP_WEBHOOK_SECRET=CHANGEME
TELESRV_OTP_WEBHOOK_TIMEOUT=5s

# The public v2 image deliberately includes the repository's published test RSA
# pair so a fresh deployment matches the test clients. Existing edge_state data
# is never overwritten. Use "generated" with the private-key-free edge target
# for a separate deployment identity.
TELESRV_RSA_IDENTITY_MODE=test

# Must be an IPv4/IPv6 address reachable by patched clients, never a DNS name.
TELESRV_ADVERTISE_IP=CHANGEME
TELESRV_ADVERTISE_PORT=2398
TELESRV_DEFAULT_COUNTRY_CODE=CN
TELESRV_PUBLIC_BASE_URL=CHANGEME
TELESRV_PUBLIC_APP_SCHEME=telesrv
TELESRV_PUBLIC_WEB_BASE_URL=CHANGEME

# Host publishing. PostgreSQL, Redis and internal gRPC ports are not published.
TELESRV_PUBLIC_BIND_IP=127.0.0.1
TELESRV_LOCAL_BIND_IP=127.0.0.1
TELESRV_EDGE_PORT=2398
TELESRV_SFU_UDP_PORT=12399
TELESRV_PUBLIC_LINK_PORT=2401

# Default durable blob backend. Once media has been written, follow the storage
# migration runbook before changing this value.
TELESRV_BLOB_BACKEND=localfs
TELESRV_EXTERNAL_MEDIA_ENABLE=true
TELESRV_WEBPAGE_PREVIEW_ENABLE=true

# S3-compatible backend (used only when TELESRV_BLOB_BACKEND=s3).
TELESRV_S3_ENDPOINT=
TELESRV_S3_REGION=
TELESRV_S3_BUCKET=
TELESRV_S3_ACCESS_KEY_ID=
TELESRV_S3_SECRET_ACCESS_KEY=
TELESRV_S3_USE_SSL=true
TELESRV_S3_PATH_STYLE=false
TELESRV_S3_CREATE_BUCKET=false
